#     /workspace/csig/bin/pip install --target HYPIR-fork/submit/model_dir \
#     HYPIR-fork/submit/csig_ops_ext --no-build-isolation"
submit/model_dir/custom_op/
submit/model_dir/custom_op-*.dist-info/
